  "introduction": {
    "title": "حيث أصبح الفضول مسيرة مهنية",
    "description": [
      "لم أبدأ مسيرتي بكتابة البرمجيات مباشرة، بل بدأت بطرح الأسئلة.",
      "لطالما كنت مبهوراً بكيفية عمل الأنظمة المعقدة—كيف تتفاعل المكونات الفردية وتتواصل معاً لحل مشكلات حقيقية.",
      "علمتني خلفيتي الأكاديمية في الهندسة الميكانيكية التفكير بالأنظمة: فهم القيود، تحليل العلاقات، وتصميم حلول موثوقة وفعالة.",
      "عندما اكتشفت هندسة البرمجيات، أدركت أن تلك المبادئ نفسها موجودة في العالم الرقمي. البرمجة لم تكن مجرد كتابة كود—بل كانت تصميم أنظمة وتجريد وتفكير منطقي.",
      "قدرة تحويل الأفكار إلى منتجات شغالة عبر جهاز حاسوب فقط أشعلت شغفاً جديداً.",
      "ما بدأ كفضول أصبح تدريجياً التزاماً بإتقان هندسة البرمجيات وبناء منتجات يستمتع الناس بها."
    ],
    "modules": [
      "HTML",
      "CSS",
      "JavaScript",
      "React",
      "أساسيات علوم الحاسوب"
    ]
  },
  "learningJourney": {
    "title": "التعلم من خلال البناء",
    "description": [
      "بدأت رحلتي البرمجية مع The Odin Project، وهو منهج مبني على فلسفة بسيطة: أفضل طريقة للتعلم هي بناء برمجيات حقيقية.",
      "بدلاً من حفظ القواعد، قدم كل مشروع مفهوماً هندسياً جديداً يبني على ما قبله.",
      "تعلمت فهم ليس فقط كيفية كتابة الكود، بل لماذا توجد لغات البرمجة وأطر العمل وأنماط التصميم.",
      "خلال هذه الرحلة استكشفت:",
      [
        "كيف تقوم المتصفحات بعرض صفحات الويب",
        "HTML الدلالي وإمكانية الوصول",
        "تخطيطات CSS الحديثة",
        "أساسيات JavaScript",
        "التعامل مع DOM",
        "الخوارزميات والتفكير الحسابي",
        "البرمجة كائنية التوجه (OOP)",
        "البرمجة الوظيفية (FP)",
        "النطاقات والإنغلاقات (Closures)",
        "أنماط تصميم البرمجيات",
        "REST APIs",
        "معمارية مكونات React"
      ],
      "أصبح كل مشروع فرصة لاستكشاف مفهوم هندسي جديد.",
      "وأصبحت كل مشكلة تمريناً لتنقيح البرمجيات وتصحيح الأخطاء."
    ]
  },
